# ==========================================
# NexusCraft Deployment Environment Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Nexuscraft?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Client URL (For CORS allow-list in split deployments, e.g. Vercel)
CLIENT_URL=https://nexuscraft.vercel.app
FRONTEND_URL=https://nexuscraft.vercel.app

# Google Gemini AI API Key (Optional: for live AI blueprint synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# Client Environment (Vite Frontend)
VITE_API_URL=https://your-backend-api.onrender.com/api
